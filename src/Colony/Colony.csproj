<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright (c) 2026 Zethrel. All rights reserved. See LICENSE. -->
  <!-- The colony: the Wardens' settlement played up close (the design library's local tier). Plain .NET, no
       Godot, so its tests run anywhere. It uses the same dice as the history (src/Sim's Dice). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WardensReckoning.Colony</AssemblyName>
    <RootNamespace>WardensReckoning.Colony</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests may set a colonist's needs directly (to start a test hungry, say). -->
    <InternalsVisibleTo Include="WardensReckoning.Tests" />
  </ItemGroup>
</Project>
